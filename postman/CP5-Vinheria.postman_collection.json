        {
          "name": "Criar service group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "fiware-service",
                "value": "smart"
              },
              {
                "key": "fiware-servicepath",
                "value": "/"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{url}}:4041/iot/services",
              "protocol": "http",
              "host": [
                "{{url}}"
              ],
              "port": "4041",
              "path": [
                "iot",
                "services"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"services\": [\n    {\n      \"apikey\": \"TEF\",\n      \"cbroker\": \"http://{{url}}:1026\",\n      \"entity_type\": \"Thing\",\n      \"resource\": \"\",\n      \"timestamp\": true\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "timestamp:true preenche TimeInstant a cada medicao (necessario para detectar offline). 409 se ja existir."
          }
        },
        {
